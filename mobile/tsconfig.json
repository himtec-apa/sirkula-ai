{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@sirkula/shared-types": [
        "./src/types/sirkula.ts"
      ],
      "@sirkula/bio-thermal-sdk": [
        "./src/lib/bio-thermal-sdk.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}