# SIRKULA-AI Mobile Environment Configuration
# ============================================

# Backend API URL (Otomatis resolved ke IP LAN jika diakses via Expo Go HP Fisik)
EXPO_PUBLIC_API_URL=http://localhost:4000

# WebSocket Gateway URL (Socket.io)
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000

# Cryptography HMAC Secret Key (Wajib sama persis dengan backend)
EXPO_PUBLIC_HMAC_SECRET_KEY=sirkula-super-secure-hmac-secret-key-32chars

# Mode data: false = langsung konek ke backend NestJS live, true = standalone mock
EXPO_PUBLIC_USE_MOCK=false
