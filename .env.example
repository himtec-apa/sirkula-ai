# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/sirkula_db

# Redis Connection
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=sirkula-redis-secure-pass
REDIS_URL=redis://:sirkula-redis-secure-pass@redis:6379

# External APIs
OPENWEATHER_API_KEY=YOUR_OPEN_WEATHER_API_KEY
GEMINI_API_KEY=mock-gemini-key

# AI Vision (9router / OpenAI-Compatible Endpoint)
AI_API_KEY=YOUR_OPENAI_API_KEY
AI_BASE_URL=http://host.docker.internal:20128/v1
AI_MODEL=ag/gemini-3.8-flash-high

# Cryptography & Security
HMAC_SECRET_KEY=sirkula-super-secure-hmac-secret-key-32chars
JWT_SECRET=sirkula-jwt-secret-key-minimum-32chars
