# SIRKULA-AI Frontend Environment Configuration
# ===============================================

# 1. Tile Provider Peta
# Pilihan provider: openstreetmap | mapbox | maptiler | cartodb | stadia
# Default: openstreetmap (GRATIS, tanpa watermark, tidak memerlukan API key, langsung jalan)
MAP_PROVIDER=openstreetmap

# 2. API Key / Access Token Peta (Opsional jika menggunakan provider berbayar / custom)
# - CartoDB / OSM: Kosongkan (tidak perlu API key)
# - Mapbox: Dapatkan token di https://account.mapbox.com/
#   MAP_PROVIDER=mapbox
#   MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0...
# - MapTiler: Dapatkan key di https://cloud.maptiler.com/
#   MAP_PROVIDER=maptiler
#   MAPTILER_KEY=your_maptiler_api_key
# - Stadia Maps: Dapatkan key di https://client.stadiamaps.com/
#   MAP_PROVIDER=stadia
#   MAP_API_KEY=your_stadia_api_key

MAP_API_KEY=
MAPBOX_TOKEN=
MAPTILER_KEY=

# 3. Backend API URL (Opsional, default otomatis mengikuti hostname:4000)
API_BASE_URL=http://localhost:4000
