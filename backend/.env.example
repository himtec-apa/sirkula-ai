# Node Environment
NODE_ENV=development
PORT=4000

# PostgreSQL + PostGIS Connection
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sirkula_db

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# External APIs
OPENWEATHER_API_KEY=mock-openweather-key
GEMINI_API_KEY=mock-gemini-key

# AI Vision (9router / OpenAI-Compatible Endpoint)
AI_API_KEY=your-9router-or-openai-api-key
AI_BASE_URL=https://api.9router.com/v1
AI_MODEL=gemini-2.5-flash

# Cryptography & Security
HMAC_SECRET_KEY=sirkula-super-secure-hmac-secret-key-32chars
JWT_SECRET=sirkula-jwt-secret-key-minimum-32chars
